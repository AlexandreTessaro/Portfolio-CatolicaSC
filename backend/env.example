# ==============================================================================
# CONFIGURAÇÕES DE AMBIENTE - Startup Collaboration Platform
# ==============================================================================
# Este arquivo contém todas as variáveis de ambiente necessárias para o projeto.
# Copie este arquivo para .env e ajuste os valores conforme seu ambiente.
#
# AMBIENTES:
#   - Development: Desenvolvimento local
#   - Test: Testes automatizados
#   - Production: Produção
# ==============================================================================

# ==============================================================================
# CONFIGURAÇÕES DO SERVIDOR
# ==============================================================================
# NODE_ENV: Ambiente de execução (development, test, production)
NODE_ENV=development

# PORT: Porta em que o servidor irá escutar
# Development: 5000
# Test: 5001
# Production: 5000 (ou conforme seu provedor)
PORT=5000

# FRONTEND_URL: URL do frontend para CORS e redirecionamentos
# Development: http://localhost:3000
# Test: http://localhost:3001
# Production: https://your-frontend-domain.com
FRONTEND_URL=http://localhost:3000

# ==============================================================================
# CONFIGURAÇÕES DO BANCO DE DADOS POSTGRESQL
# ==============================================================================

# DESENVOLVIMENTO/TESTE: Use variáveis individuais
# DB_HOST: Host do banco de dados
DB_HOST=localhost

# DB_PORT: Porta do PostgreSQL
DB_PORT=5432

# DB_USER: Usuário do banco de dados
DB_USER=postgres

# DB_PASSWORD: Senha do banco de dados
# ⚠️ ALTERE ESTA SENHA EM PRODUÇÃO!
DB_PASSWORD=your-database-password

# DB_NAME: Nome do banco de dados
# Development: portfolio-catolicasc
# Test: startup_collab_test
# Production: seu-banco-producao
DB_NAME=portfolio-catolicasc

# DB_SSL: Habilitar SSL na conexão
# Development: false
# Production: true (recomendado)
DB_SSL=false

# PRODUÇÃO: Use DATABASE_URL (recomendado para produção)
# Descomente e configure para produção:
# DATABASE_URL=postgresql://username:password@host:5432/database_name
#
# Exemplos para diferentes provedores:
# AWS RDS: postgresql://username:password@your-rds-endpoint.region.rds.amazonaws.com:5432/database_name
# Google Cloud SQL: postgresql://username:password@your-instance-ip:5432/database_name
# DigitalOcean: postgresql://username:password@your-db-endpoint:5432/database_name
# Railway: postgresql://username:password@your-railway-endpoint:5432/database_name
# Render: postgresql://username:password@your-render-endpoint:5432/database_name
# DATABASE_URL=

# ==============================================================================
# CONNECTION POOLING (Otimização para alta concorrência)
# ==============================================================================
# Configurações do pool de conexões do PostgreSQL
# Ajuste conforme sua necessidade de concorrência

# DB_POOL_MAX: Máximo de conexões no pool
# Development: 50
# Production: 100 (para 1000+ usuários simultâneos)
DB_POOL_MAX=50

# DB_POOL_MIN: Mínimo de conexões mantidas
# Development: 5
# Production: 10
DB_POOL_MIN=5

# DB_POOL_IDLE_TIMEOUT: Timeout para conexões idle em milissegundos
DB_POOL_IDLE_TIMEOUT=30000

# DB_POOL_CONNECTION_TIMEOUT: Timeout para criar conexão em milissegundos
# Development: 2000
# Production: 30000
DB_POOL_CONNECTION_TIMEOUT=2000

# ==============================================================================
# CONFIGURAÇÕES DO REDIS (Cache e Sessões)
# ==============================================================================
# REDIS_URL: URL de conexão do Redis
# Development: redis://localhost:6379
# Production: redis://your-redis-host:6379
# Redis na nuvem: rediss://username:password@your-redis-endpoint:6379
REDIS_URL=redis://localhost:6379

# REDIS_ENABLED: Habilitar Redis
# Development: false (opcional)
# Production: true (recomendado para cache)
REDIS_ENABLED=false

# ==============================================================================
# CONFIGURAÇÕES JWT (Autenticação)
# ==============================================================================
# ⚠️ IMPORTANTE: Altere estes valores em produção!
# Use strings longas e aleatórias (mínimo 32 caracteres)

# JWT_SECRET: Chave secreta para tokens JWT
# Development: your-super-secret-jwt-key-change-in-production
# Production: Gere uma chave forte e segura!
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# JWT_REFRESH_SECRET: Chave secreta para refresh tokens
# Development: your-super-secret-refresh-jwt-key-change-in-production
# Production: Gere uma chave forte e segura!
JWT_REFRESH_SECRET=your-super-secret-refresh-jwt-key-change-in-production

# ==============================================================================
# CONFIGURAÇÕES DE SEGURANÇA
# ==============================================================================
# BCRYPT_SALT_ROUNDS: Número de rounds para hash de senhas
# Development: 10 (mais rápido)
# Production: 12 (mais seguro, recomendado)
BCRYPT_SALT_ROUNDS=12

# ==============================================================================
# CONFIGURAÇÕES DE EMAIL (SMTP)
# ==============================================================================
# Configurações para envio de emails (opcional)
# Development: Pode deixar vazio ou usar serviço de teste (Mailtrap, etc)
# Production: Configure com seu provedor SMTP

# SMTP_HOST: Servidor SMTP
SMTP_HOST=smtp.gmail.com

# SMTP_PORT: Porta SMTP
SMTP_PORT=587

# SMTP_USER: Usuário/email SMTP
SMTP_USER=your-email@gmail.com

# SMTP_PASS: Senha ou app password SMTP
# Para Gmail, use App Password: https://support.google.com/accounts/answer/185833
SMTP_PASS=your-app-password

# ==============================================================================
# CONFIGURAÇÕES DE LOG
# ==============================================================================
# LOG_LEVEL: Nível de log (error, warn, info, debug)
# Development: info
# Test: error (menos verboso)
# Production: info
LOG_LEVEL=info

# LOG_FILE: Caminho do arquivo de log
LOG_FILE=logs/app.log

# ==============================================================================
# CONFIGURAÇÕES FIREBASE (OAuth 2.0 - Opcional)
# ==============================================================================
# Configurações para autenticação com Firebase (OAuth)
# Deixe vazio se não estiver usando Firebase

# FIREBASE_PROJECT_ID: ID do projeto Firebase
FIREBASE_PROJECT_ID=your-firebase-project-id

# FIREBASE_SERVICE_ACCOUNT: JSON completo da service account como string
# Opção 1: JSON completo como string (recomendado para produção)
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"...","client_email":"...","client_id":"...","auth_uri":"...","token_uri":"...","auth_provider_x509_cert_url":"...","client_x509_cert_url":"..."}

# Opção 2: Variáveis individuais (alternativa)
# FIREBASE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com

# ==============================================================================
# CONFIGURAÇÕES DE MONITORAMENTO (Opcional)
# ==============================================================================
# Configurações para serviços de monitoramento e observabilidade

# MONITORING_PROVIDER: Provedor de monitoramento (none, applicationinsights, datadog, newrelic)
MONITORING_PROVIDER=none

# Application Insights (Azure)
# APPLICATIONINSIGHTS_CONNECTION_STRING=InstrumentationKey=...

# Datadog
# DATADOG_API_KEY=your-datadog-api-key
# DATADOG_SERVICE_NAME=startup-collab-backend
# DATADOG_ENV=production

# New Relic
# NEW_RELIC_LICENSE_KEY=your-new-relic-license-key
# NEW_RELIC_APP_NAME=startup-collab-backend

# ==============================================================================
# SONARQUBE / SONARCLOUD (Análise de Código - Opcional)
# ==============================================================================
# Configurações para análise de qualidade de código

# SONAR_TOKEN: Token do SonarCloud/SonarQube
# SONAR_TOKEN=your-sonar-token

# SONAR_HOST_URL: URL do SonarCloud/SonarQube
# SonarCloud: https://sonarcloud.io
# SonarQube local: http://localhost:9000
# SONAR_HOST_URL=https://sonarcloud.io

# SONAR_ORGANIZATION: Organização no SonarCloud
# SONAR_ORGANIZATION=your-organization

# ==============================================================================
# VALORES RECOMENDADOS POR AMBIENTE
# ==============================================================================
#
# DESENVOLVIMENTO:
#   NODE_ENV=development
#   PORT=5000
#   FRONTEND_URL=http://localhost:3000
#   DB_HOST=localhost
#   DB_NAME=portfolio-catolicasc
#   DB_SSL=false
#   REDIS_ENABLED=false
#   LOG_LEVEL=info
#
# TESTE:
#   NODE_ENV=test
#   PORT=5001
#   FRONTEND_URL=http://localhost:3001
#   DB_NAME=startup_collab_test
#   DB_SSL=false
#   REDIS_ENABLED=false
#   LOG_LEVEL=error
#   JWT_SECRET=test-secret-key-for-testing-only
#   JWT_REFRESH_SECRET=test-refresh-secret-key-for-testing-only
#   BCRYPT_SALT_ROUNDS=10
#
# PRODUÇÃO:
#   NODE_ENV=production
#   PORT=5000 (ou conforme seu provedor)
#   FRONTEND_URL=https://your-frontend-domain.com
#   DATABASE_URL=postgresql://... (use connection string)
#   DB_SSL=true
#   REDIS_ENABLED=true
#   LOG_LEVEL=info
#   JWT_SECRET=<chave-forte-e-aleatoria>
#   JWT_REFRESH_SECRET=<chave-forte-e-aleatoria>
#   BCRYPT_SALT_ROUNDS=12
#   SMTP_* configurado com valores reais
#
# ==============================================================================
